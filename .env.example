# Copy to .env. This file is the only place Switchboard reads secrets from,
# and .env is gitignored. Nothing here is required: with no key at all,
# Switchboard runs entirely on this machine.

# TypeSafe Jev, the cloud decision backend. Create a key at
# https://console.typesafe.ai/. Without it the Jev backend reports itself as
# "unconfigured" and the chain falls through to the local and rule backends.
# TYPESAFE_API_KEY=

# Anything in config/switchboard.toml can be overridden here or in the
# environment, as SWITCHBOARD_<SECTION>__<KEY>. A few useful ones:

# Never switch models; report what would have happened instead.
# SWITCHBOARD_ROUTING__MODE=shadow

# Keep every decision on this machine even when a key is configured.
# SWITCHBOARD_PRIVACY__ALLOW_CLOUD=false

# Stop storing short redacted previews of requests (hashes only).
# SWITCHBOARD_PRIVACY__STORE_PREVIEWS=false

# Move the listening port.
# SWITCHBOARD_SERVER__PORT=8002

# Point at a different llama-server.
# SWITCHBOARD_UPSTREAM__BASE_URL=http://127.0.0.1:10000
